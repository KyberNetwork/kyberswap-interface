{
  "buildCommand": "pnpm install && pnpm run build-package && cd apps/kyberswap-interface && pnpm run build",
  "outputDirectory": "apps/kyberswap-interface/build",
  "installCommand": "pnpm install",
  "regions": ["sin1"],
  "routes": [
    {
      "src": "/__ks/(.*)",
      "dest": "/api/ks-proxy?__ks_path=$1"
    },
    {
      "src": "/[^.]+",
      "dest": "/",
      "status": 200
    }
  ]
}
